# Add these in Netlify → Project configuration → Environment variables
# (for local development, `netlify dev` pulls them from your site).
# The database and image storage need no settings: Netlify sets them up automatically.

# Optional: AI tagging uses Netlify's AI Gateway (Netlify credits) by default.
# Set your own key from console.anthropic.com to be billed by Anthropic instead.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model tags your items (defaults to claude-opus-5-5).
# claude-sonnet-5-5 costs about half as much and is a good choice on the free plan.
# CLAUDE_MODEL=claude-sonnet-5-5

# The password you type to open the app
APP_PASSWORD=choose-a-long-password

# Secret the iPhone Shortcut sends with each save (long and random, 16+ characters)
SAVE_TOKEN=
