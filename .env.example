# Copy to .env.local for local development, and add the same values in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model tags your items (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# The password you type to open the app
APP_PASSWORD=choose-a-long-password

# Secret the iPhone Shortcut sends with each save (make it long and random, 16+ characters)
# e.g. run: openssl rand -hex 24
SAVE_TOKEN=
